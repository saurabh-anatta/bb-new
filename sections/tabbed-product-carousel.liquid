{% liquid
  assign heading = section.settings.heading
  assign description = section.settings.description
  assign products_to_show = section.settings.products_to_show
  assign collections = section.settings.collections
  assign has_collections = false
  if collections.size > 0
    assign has_collections = true
  endif

  unless has_collections
    assign fallback_tab_count = 0
    assign first_fallback_index = -1
    for i in (1..5)
      assign label_key = 'tab_' | append: i | append: '_label'
      assign label = section.settings[label_key]
      if label != blank
        assign fallback_tab_count = fallback_tab_count | plus: 1
        if first_fallback_index == -1
          assign first_fallback_index = i
        endif
      endif
    endfor
  endunless
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<tabbed-product-carousel
  class="
    section
    section--page-width
    color-{{ section.settings.color_scheme }}
    tabbed-product-carousel
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    --tpc-columns-gap: {{ section.settings.columns_gap }}px;
  "
>
  <div class="page-width">
    <div class="tabbed-product-carousel__header">
      {% if heading != blank %}
        <h2 class="tabbed-product-carousel__heading">
          {{ heading | escape }}
        </h2>
      {% endif %}

      {% if has_collections %}
        <div class="tabbed-product-carousel__tabs-wrapper">
          <div class="tabbed-product-carousel__tabs" role="tablist">
            {% for col in collections %}
              {% assign tab_index = forloop.index %}
              {% assign label_key = 'tab_' | append: tab_index | append: '_label' %}
              {% assign custom_label = section.settings[label_key] %}

              <button
                type="button"
                class="tabbed-product-carousel__tab{% if forloop.first %} tabbed-product-carousel__tab--active{% endif %}"
                role="tab"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-controls="tabpanel-{{ section.id }}-{{ tab_index }}"
                data-tab-index="{{ tab_index }}"
              >
                {% if custom_label != blank %}
                  {{ custom_label | escape }}
                {% else %}
                  {{ col.title | escape }}
                {% endif %}
              </button>
            {% endfor %}
          </div>
        </div>
      {% elsif fallback_tab_count > 0 %}
        <div class="tabbed-product-carousel__tabs-wrapper">
          <div class="tabbed-product-carousel__tabs" role="tablist">
            {% for i in (1..5) %}
              {% assign label_key = 'tab_' | append: i | append: '_label' %}
              {% assign label = section.settings[label_key] %}

              {% if label != blank %}
                <button
                  type="button"
                  class="tabbed-product-carousel__tab{% if i == first_fallback_index %} tabbed-product-carousel__tab--active{% endif %}"
                  role="tab"
                  aria-selected="{% if i == first_fallback_index %}true{% else %}false{% endif %}"
                  aria-controls="tabpanel-{{ section.id }}-{{ i }}"
                  data-tab-index="{{ i }}"
                >
                  {{ label | escape }}
                </button>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endif %}

      {% if description != blank %}
        <p class="tabbed-product-carousel__description">
          {{ description | escape }}
        </p>
      {% endif %}
    </div>

    <div class="tabbed-product-carousel__panels">
      {% if has_collections %}
        {% for col in collections %}
          <div
            class="tabbed-product-carousel__panel"
            id="tabpanel-{{ section.id }}-{{ forloop.index }}"
            role="tabpanel"
            {% unless forloop.first %}hidden{% endunless %}
          >
            <div class="tabbed-product-carousel__products">
              {% for product in col.products limit: products_to_show %}
                <div class="tabbed-product-carousel__card">
                  {% # theme-check-disable UniqueStaticBlockId %}
                    {% content_for 'block', type: '_product-card', id: 'product-card', closest.product: product %}
                  {% # theme-check-enable UniqueStaticBlockId %}
                </div>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      {% elsif fallback_tab_count > 0 %}
        {% for i in (1..5) %}
          {% assign label_key = 'tab_' | append: i | append: '_label' %}
          {% assign label = section.settings[label_key] %}

          {% if label != blank %}
            <div
              class="tabbed-product-carousel__panel"
              id="tabpanel-{{ section.id }}-{{ i }}"
              role="tabpanel"
              {% unless i == first_fallback_index %}hidden{% endunless %}
            >
              <div class="tabbed-product-carousel__products">
                {% for j in (1..products_to_show) %}
                  <div class="tabbed-product-carousel__card">
                    {% # theme-check-disable UniqueStaticBlockId %}
                      {% content_for 'block', type: '_product-card', id: 'product-card', closest.product: null %}
                    {% # theme-check-enable UniqueStaticBlockId %}
                  </div>
                {% endfor %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      {% else %}
        <div class="tabbed-product-carousel__panel">
          <div class="tabbed-product-carousel__products">
            {% for j in (1..products_to_show) %}
              <div class="tabbed-product-carousel__card">
                {% # theme-check-disable UniqueStaticBlockId %}
                  {% content_for 'block', type: '_product-card', id: 'product-card', closest.product: null %}
                {% # theme-check-enable UniqueStaticBlockId %}
              </div>
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</tabbed-product-carousel>

{% style %}
  #shopify-section-{{ section.id }} .tabbed-product-carousel {
    --padding-block-start: {% if section.settings.padding-block-start > 20 %}max(20px, calc(var(--spacing-scale) * {{ section.settings.padding-block-start }}px)){% else %}{{ section.settings.padding-block-start }}px{% endif %};
    --padding-block-end: {% if section.settings.padding-block-end > 20 %}max(20px, calc(var(--spacing-scale) * {{ section.settings.padding-block-end }}px)){% else %}{{ section.settings.padding-block-end }}px{% endif %};
    padding-block-start: var(--padding-block-start);
    padding-block-end: var(--padding-block-end);
  }
{% endstyle %}

{% stylesheet %}
  .tabbed-product-carousel {
    box-shadow: inset 0 20px 20px rgba(0, 0, 0, 0.03);
  }

  .tabbed-product-carousel .page-width {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  @media screen and (min-width: 750px) {
    .tabbed-product-carousel .page-width {
      gap: 40px;
    }
  }

  .tabbed-product-carousel__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .tabbed-product-carousel__heading {
    font-family: var(--font-heading--family);
    font-weight: 600;
    font-size: 24px;
    line-height: 34px;
    letter-spacing: -0.48px;
    text-align: center;
    color: var(--color-foreground-heading);
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .tabbed-product-carousel__heading {
      font-size: 32px;
      line-height: 45px;
      letter-spacing: -0.64px;
    }
  }

  .tabbed-product-carousel__tabs-wrapper {
    display: flex;
    justify-content: center;
    width: 100%;
    border-bottom: 1px solid #C9CAD4;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .tabbed-product-carousel__tabs-wrapper::-webkit-scrollbar {
    display: none;
  }

  .tabbed-product-carousel__tabs {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 48px;
    width: fit-content;
    margin: 0 auto;
  }

  .tabbed-product-carousel__tab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 0;
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 16px;
    line-height: 22px;
    color: #888B95;
    background: transparent;
    border: none;
    border-bottom: 3px solid transparent;
    margin-bottom: -1px;
    cursor: pointer;
    white-space: nowrap;
    transition: color 0.2s, font-weight 0.15s, border-color 0.2s;
  }

  .tabbed-product-carousel__tab--active {
    font-weight: 600;
    color: var(--color-foreground-heading);
    border-bottom-color: #005695;
  }

  .tabbed-product-carousel__tab:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  @media screen and (max-width: 749px) {
    .tabbed-product-carousel__tabs {
      gap: 16px;
      justify-content: flex-start;
    }

    .tabbed-product-carousel__tab {
      font-size: 14px;
    }
  }

  .tabbed-product-carousel__description {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 14px;
    line-height: 20px;
    text-align: center;
    color: var(--color-foreground);
    margin: 0;
    max-width: 1308px;
  }

  @media screen and (min-width: 750px) {
    .tabbed-product-carousel__description {
      font-size: 16px;
      line-height: 22px;
    }
  }

  .tabbed-product-carousel__products {
    display: flex;
    flex-direction: row;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 4px;
  }

  .tabbed-product-carousel__products::-webkit-scrollbar {
    display: none;
  }

  .tabbed-product-carousel__card {
    min-width: 78%;
    flex-shrink: 0;
    scroll-snap-align: start;
  }

  @media screen and (min-width: 750px) {
    .tabbed-product-carousel__products {
      gap: var(--tpc-columns-gap, 32px);
      overflow-x: visible;
      scroll-snap-type: none;
      flex-wrap: wrap;
    }

    .tabbed-product-carousel__card {
      min-width: 0;
      flex: 1 1 calc(25% - var(--tpc-columns-gap, 32px) * 3 / 4);
      max-width: calc(25% - var(--tpc-columns-gap, 32px) * 3 / 4);
      scroll-snap-align: none;
    }
  }
{% endstylesheet %}

<script>
  if (!customElements.get('tabbed-product-carousel')) {
    class TabbedProductCarousel extends HTMLElement {
      connectedCallback() {
        this.tabs = this.querySelectorAll('.tabbed-product-carousel__tab');
        this.panels = this.querySelectorAll('.tabbed-product-carousel__panel');

        for (const tab of this.tabs) {
          tab.addEventListener('click', this.handleTabClick.bind(this));
        }
      }

      handleTabClick(event) {
        const clickedTab = event.currentTarget;
        const tabIndex = clickedTab.dataset.tabIndex;
        const sectionId = this.closest('.shopify-section').id.replace('shopify-section-', '');

        for (const tab of this.tabs) {
          const isActive = tab.dataset.tabIndex === tabIndex;
          tab.classList.toggle('tabbed-product-carousel__tab--active', isActive);
          tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
        }

        for (const panel of this.panels) {
          const panelId = 'tabpanel-' + sectionId + '-' + tabIndex;
          if (panel.id === panelId) {
            panel.removeAttribute('hidden');
          } else {
            panel.setAttribute('hidden', '');
          }
        }
      }
    }

    customElements.define('tabbed-product-carousel', TabbedProductCarousel);
  }
</script>

{% schema %}
{
  "name": "t:names.tabbed_product_carousel",
  "class": "container-background-image",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
